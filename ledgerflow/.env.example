DATABASE_URL="postgresql://ledgerflow:ledgerflow@localhost:5432/ledgerflow?schema=public"

# Windows ARM64 (Surface / Snapdragon) : décommente la ligne suivante
# pour forcer le moteur Prisma en process séparé (emulation x64).
# PRISMA_CLIENT_ENGINE_TYPE=binary

# Optional — catégorisation LLM (le fallback PCG marche sans)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
