# Application
APP_NAME=AutoTrading Lemon
APP_VERSION=0.1.0-lemon
DEBUG=false
HOST=0.0.0.0
PORT=8100

# Base de données (SQLite par défaut — zéro coût VPS)
DATABASE_URL=sqlite+aiosqlite:///./data/autotrading.db

# Scan marché (secondes)
MARKET_SCAN_INTERVAL_SECONDS=300
POSITION_CHECK_INTERVAL_SECONDS=60
WATCHDOG_INTERVAL_SECONDS=30

# Seuils débutant
MIN_BUY_PROBABILITY=62
MIN_SELL_PROBABILITY_DROP=45
DEFAULT_TAKE_PROFIT_PCT=8
DEFAULT_STOP_LOSS_PCT=4

# Notifications Telegram (gratuit — créer un bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP optionnel (Gmail app password, Brevo free tier, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sécurité API (générer une clé aléatoire en prod)
API_SECRET_KEY=change-me-in-production-lemon
