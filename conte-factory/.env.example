# Conte Factory — vraie vidéo Wan + dialogues personnages

CONTE_CHANNEL_NAME=Contes du Soir
CONTE_TARGET_DURATION_MIN=30
CONTE_SCENE_TARGET_SEC=180

CONTE_TTS_VOICE=fr-FR-DeniseNeural
CONTE_TTS_RATE=-12%
CONTE_TTS_PITCH=-1Hz
CONTE_WORDS_PER_MIN=155

# === Moteur visuel ===
# pinokio = Wan 2.1 T2V (vraie vidéo — recommandé qualité)
# images  = illustrations + Ken Burns (rapide, diaporama)
CONTE_VIDEO_PROVIDER=pinokio
CONTE_IMAGE_BACKEND=auto
CONTE_AI_CLIP_SEC=20
CONTE_ASPECT_RATIO=16:9
CONTE_WAN_CLIP_SPAN_SEC=22

# Wan 2.1 — RTX 3080 10Go
PINOKIO_WAN_URL=http://127.0.0.1:7860
PINOKIO_WAN_RESOLUTION=480p 16:9
PINOKIO_WAN_FRAMES=13
PINOKIO_WAN_STEPS=10
WAN_DTYPE=float16
SULPHUR_CPU_OFFLOAD=1
CONTE_AUTO_START_WAN=1

# Fallback cloud (optionnel)
# CONTE_VIDEO_PROVIDER=fal
# FAL_KEY=
# CONTE_FAL_MODEL=fal-ai/kling-video/v1.6/standard/text-to-video
# CONTE_FAL_CONCURRENCY=2

CONTE_STORY_MODE=builtin
# MISTRAL_API_KEY=

CONTE_AUTO_PUBLISH=1
CONTE_YOUTUBE_PRIVACY=private
CONTE_PAUSE=0

CONTE_WAN_START_TIMEOUT_SEC=600
CONTE_MUSIC_VOLUME=0.12
CONTE_VIDEO_WIDTH=1920
CONTE_VIDEO_HEIGHT=1080
CONTE_VIDEO_FPS=30
