# Conte Factory — pipeline I2V (vraie animation Wan)

CONTE_CHANNEL_NAME=Contes du Soir
CONTE_TARGET_DURATION_MIN=30

CONTE_TTS_VOICE=fr-FR-DeniseNeural
CONTE_TTS_RATE=-12%
CONTE_TTS_PITCH=-1Hz
CONTE_WORDS_PER_MIN=155

# i2v = TTS -> image Pixar -> Wan I2V anime -> FFmpeg (recommande)
# talking = legacy Wav2Lip | pinokio = T2V | images = diaporama
CONTE_VIDEO_PROVIDER=i2v
CONTE_IMAGE_BACKEND=auto
CONTE_ASPECT_RATIO=16:9

CONTE_VIDEO_FPS=24
CONTE_VIDEO_WIDTH=1920
CONTE_VIDEO_HEIGHT=1080
CONTE_MUSIC_VOLUME=0.20
CONTE_EXPORT_4K=0

# Wan Image-to-Video (vraie animation)
PINOKIO_I2V_URL=http://127.0.0.1:7861
PINOKIO_I2V_FRAMES=49
PINOKIO_I2V_STEPS=20
CONTE_AUTO_START_I2V=1
CONTE_I2V_TIMEOUT_SEC=600

# Lip-sync legacy (desactive par defaut)
PINOKIO_LIPSYNC_URL=http://127.0.0.1:7870
CONTE_AUTO_START_LIPSYNC=0
CONTE_LIPSYNC_TIMEOUT_SEC=300

# Wan T2V optionnel
PINOKIO_WAN_URL=http://127.0.0.1:7860
PINOKIO_WAN_FRAMES=13
PINOKIO_WAN_STEPS=10
WAN_DTYPE=float16
SULPHUR_CPU_OFFLOAD=1
CONTE_AUTO_START_WAN=0

CONTE_STORY_MODE=builtin
CONTE_AUTO_PUBLISH=1
CONTE_YOUTUBE_PRIVACY=private
CONTE_PAUSE=0
