# Trame d'origine — Wan Pinokio + publication auto après montage

CONTE_CHANNEL_NAME=Contes du Soir
CONTE_TARGET_DURATION_MIN=30
CONTE_SCENE_TARGET_SEC=60

CONTE_TTS_VOICE=fr-FR-DeniseNeural
CONTE_TTS_RATE=-5%

# === Moteur vidéo IA (recommandé) ===
# Wan 2.1 T2V 1.3B via Pinokio (app pinokio/wan-snapdragon-arm)
CONTE_VIDEO_PROVIDER=pinokio
PINOKIO_WAN_URL=http://127.0.0.1:7860
# PINOKIO_WAN_ENGINE=C:\pinokio\api\wan-snapdragon-arm.git\app\wan_engine.py
# PINOKIO_WAN_PYTHON=C:\pinokio\api\wan-snapdragon-arm.git\env\Scripts\python.exe
PINOKIO_WAN_RESOLUTION=480p 16:9
PINOKIO_WAN_FRAMES=33
PINOKIO_WAN_STEPS=20

# Chaque clip Wan (~2 s de mouvement) est bouclé pour couvrir CONTE_AI_CLIP_SEC d'audio
CONTE_AI_CLIP_SEC=20
CONTE_ASPECT_RATIO=16:9

# Fallback cloud (optionnel)
# CONTE_VIDEO_PROVIDER=fal
# FAL_KEY=
# CONTE_FAL_MODEL=fal-ai/kling-video/v1.6/standard/text-to-video
# CONTE_FAL_CONCURRENCY=2

CONTE_STORY_MODE=builtin
# MISTRAL_API_KEY=

CONTE_AUTO_PUBLISH=1
CONTE_YOUTUBE_PRIVACY=private
CONTE_PAUSE=0
CONTE_MUSIC_VOLUME=0.12
CONTE_VIDEO_WIDTH=1920
CONTE_VIDEO_HEIGHT=1080
CONTE_VIDEO_FPS=30
