# Copie ce fichier vers .env et adapte si besoin.
# cp .env.example .env

CONTE_CHANNEL_NAME=Contes du Soir
CONTE_TARGET_DURATION_MIN=30
CONTE_SCENE_TARGET_SEC=60

# Voix douce Edge-TTS
CONTE_TTS_VOICE=fr-FR-DeniseNeural
CONTE_TTS_RATE=-5%

# demo = images dessinées localement (aucun compte)
# pollinations = images IA gratuites (internet)
# openai = DALL·E (clé payante)
CONTE_IMAGE_MODE=demo

# builtin = histoires intégrées (aucun compte)
# mistral = API Mistral
# ollama = modèle local
CONTE_STORY_MODE=builtin
# MISTRAL_API_KEY=
# OLLAMA_URL=http://127.0.0.1:11434

# Sécurité J1 : pas d'upload auto
CONTE_AUTO_PUBLISH=0
CONTE_YOUTUBE_PRIVACY=private

# 1 = pipeline arrêté
CONTE_PAUSE=0

CONTE_MUSIC_VOLUME=0.12
CONTE_VIDEO_WIDTH=1920
CONTE_VIDEO_HEIGHT=1080
CONTE_VIDEO_FPS=30
