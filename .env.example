# LLM Local
LOCAL_LLM_URL=http://localhost:1234/v1
PORT=3000

# eBay Sandbox (publish)
EBAY_CLIENT_ID=your_sandbox_app_id
EBAY_CLIENT_SECRET=your_sandbox_cert_id
EBAY_USER_TOKEN="colle_ici_le_token_du_portail"

# Optionnel: clés Production pour Browse API (Title Builder / Classements / Compétiteurs live)
# Si omis, réutilise EBAY_CLIENT_ID/SECRET (marche si l'app a accès production)
# EBAY_PROD_CLIENT_ID=
# EBAY_PROD_CLIENT_SECRET=
# EBAY_BROWSE_BASE=https://api.ebay.com
# EBAY_BROWSE_AUTH_URL=https://api.ebay.com/identity/v1/oauth2/token

EBAY_API_BASE=https://api.sandbox.ebay.com
EBAY_AUTH_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token

# Marketplace Sandbox (compte US → EBAY_US)
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_CATEGORY_ID=175672

# Business Policies — générées via: node create-policies.js
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
