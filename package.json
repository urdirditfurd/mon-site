{
  "name": "ebx",
  "version": "1.0.0",
  "description": "EBX — AI Dropshipping Automation Dashboard with Local LLM",
  "main": "ebx/server.js",
  "scripts": {
    "start": "node ebx/server.js",
    "dev": "node ebx/server.js",
    "kill-port": "node ebx/scripts/kill-port.js 3000",
    "restart": "node ebx/scripts/kill-port.js 3000 && node ebx/server.js",
    "policies": "node ebx/create-policies.js",
    "policies:prod": "node ebx/create-policies.js --prod",
    "check": "node ebx/check-setup.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonrepair": "^3.11.2",
    "openai": "^4.77.0",
    "playwright-core": "^1.49.1"
  }
}
