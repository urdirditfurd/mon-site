# LLM Local (optionnel — LM Studio)
LOCAL_LLM_URL=http://localhost:1234/v1
PORT=3000

# ── Sécurité VPS / accès public (optionnel)
# Désactivé par défaut : le dashboard s'ouvre sans login.
# Pour un mot de passe navigateur : EBX_BASIC_AUTH_ENABLED=1 + USER/PASS.
EBX_BASIC_AUTH_ENABLED=0
EBX_BASIC_AUTH_USER=
EBX_BASIC_AUTH_PASS=

# Multi-utilisateurs (inscription) : laisse 0 en solo.
EBX_MULTIUSER=0
EBX_PUBLIC_URL=https://ton-domaine.com
EBX_SESSION_SECRET=change-cette-cle-longue

# ⚠️ SANDBOX = compte testuser uniquement.
# Les annonces n'apparaissent PAS sur ton vrai compte ebay.com.
# Pour publier en réel sur le VPS :
#   1. EBAY_ENV=production
#   2. Remplir EBAY_PROD_CLIENT_ID / SECRET + EBAY_REFRESH_TOKEN_PROD="v^1.1#..."
#      (guillemets droits obligatoires à cause du #)
#   3. Ne PAS utiliser nano si SSH se coupe : cat > .env << 'EOF' ... EOF
#   4. pm2 restart ebx --update-env && npm run env-check
#   5. Vérifier le log : « Publish mode: PRODUCTION (réel) » et refresh ≠ 0 car.

EBAY_ENV=sandbox

# ── eBay PRODUCTION (lecture Browse + publish quand EBAY_ENV=production)
# Ces clés sont celles de TON application eBay (plateforme).
# Les utilisateurs finaux connectent LEUR compte via /api/oauth/ebay/callback
EBAY_PROD_CLIENT_ID=
EBAY_PROD_CLIENT_SECRET=
# RuName / Auth Accepted URL doit être EXACTEMENT :
#   https://TON-DOMAINE/api/oauth/ebay/callback
# EBAY_RU_NAME_PROD=
# EBAY_REFRESH_TOKEN_PROD=""   # optionnel (opérateur) — les users passent par OAuth web
# EBAY_FULFILLMENT_POLICY_ID_PROD=
# EBAY_PAYMENT_POLICY_ID_PROD=
# EBAY_RETURN_POLICY_ID_PROD=

# ── eBay SANDBOX (publication test — défaut)
EBAY_CLIENT_ID=your_sandbox_app_id
EBAY_CLIENT_SECRET=your_sandbox_cert_id
EBAY_RU_NAME=
EBAY_REFRESH_TOKEN=""

EBAY_API_BASE=https://api.sandbox.ebay.com
EBAY_AUTH_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token

EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_CURRENCY=EUR
# Entrepôt Inventory API (FR recommandé si marketplace FR)
EBAY_MERCHANT_LOCATION_KEY=ebx_fr_wh

EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# ── Etsy (optionnel — même pipeline Auto-Publish)
# Crée une app : https://www.etsy.com/developers/your-apps
# Redirect URI exacte : https://TON-DOMAINE/api/oauth/etsy/callback
# (ou fixe ETSY_REDIRECT_URI). Scopes : listings_r listings_w shops_r shops_w
# ETSY_API_KEYSTRING=
# ETSY_SHARED_SECRET=
# ETSY_REDIRECT_URI=
# ETSY_TAXONOMY_ID=          # optionnel — sinon détection auto
# ETSY_SHIPPING_PROFILE_ID=  # optionnel — sinon 1er profil boutique
# ETSY_AUTO_ACTIVATE=0       # 1 = publier actif (frais listing Etsy) ; 0 = brouillon
# ETSY_WHO_MADE=someone_else
# ETSY_WHEN_MADE=made_to_order
# ETSY_IS_SUPPLY=0
