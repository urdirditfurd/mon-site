# LLM Local
LOCAL_LLM_URL=http://localhost:1234/v1
PORT=3000

# eBay Sandbox (https://developer.ebay.com/my/keys)
EBAY_CLIENT_ID=your_sandbox_app_id
EBAY_CLIENT_SECRET=your_sandbox_cert_id

# Token obtenu via "Sign in to Sandbox for OAuth" (valable ~2h)
# C'est le plus simple pour démarrer
EBAY_USER_TOKEN=colle_ici_le_token_du_portail

# Optionnel plus tard : Refresh Token (valable ~18 mois)
# EBAY_REFRESH_TOKEN=

EBAY_API_BASE=https://api.sandbox.ebay.com
EBAY_AUTH_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token

# eBay Business Policies (Sandbox Seller Hub → Account Settings → Business Policies)
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
