# LLM Local (optionnel — LM Studio)
LOCAL_LLM_URL=http://localhost:1234/v1
PORT=3000

# ── Mode publication ─────────────────────────────────────────
# sandbox = test (défaut) | production = annonces RÉELLES (ne pas activer tout de suite)
EBAY_ENV=sandbox

# ── eBay PRODUCTION (Title Builder / Classements / Compétiteurs — lecture live)
# Tu peux déjà remplir ces 2 lignes. NE PAS basculer EBAY_ENV=production pour l'instant.
EBAY_PROD_CLIENT_ID=
EBAY_PROD_CLIENT_SECRET=
# RuName Production — seulement quand on passera en réel
# EBAY_RU_NAME_PROD=

# ── eBay SANDBOX (publication de test — garde ça pour l'instant)
EBAY_CLIENT_ID=your_sandbox_app_id
EBAY_CLIENT_SECRET=your_sandbox_cert_id
EBAY_RU_NAME=
EBAY_REFRESH_TOKEN=""
# EBAY_USER_TOKEN=

EBAY_API_BASE=https://api.sandbox.ebay.com
EBAY_AUTH_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token
EBAY_BROWSE_BASE=https://api.ebay.com
EBAY_BROWSE_AUTH_URL=https://api.ebay.com/identity/v1/oauth2/token

# Marketplace Sandbox US (compte test) — en réel FR : EBAY_FR + EUR
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
# EBAY_CATEGORY_ID=

# Business Policies Sandbox
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
